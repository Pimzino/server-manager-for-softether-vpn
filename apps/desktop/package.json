{
  "name": "@sem/desktop",
  "productName": "SoftEther Manager",
  "version": "1.0.0",
  "description": "Desktop manager for SoftEther VPN Servers (macOS and Windows)",
  "private": true,
  "type": "module",
  "main": "dist/main/main.mjs",
  "author": "SoftEther Manager",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --dev",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "dist": "node scripts/dist.mjs",
    "dist:mac": "node scripts/dist.mjs --mac",
    "dist:win": "node scripts/dist.mjs --win",
    "dist:nobuild": "node scripts/dist.mjs --no-build",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "icons": "node build/icons/generate.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "vite": "^8.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@mantine/core": "^9.6.3",
    "@mantine/hooks": "^9.6.3",
    "@mantine/modals": "^9.6.3",
    "@mantine/notifications": "^9.6.3",
    "@tabler/icons-react": "^3.48.0",
    "@tanstack/react-query": "^5.104.0",
    "react-router": "^8.4.0",
    "dayjs": "^1.11.23",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "fastify": "^5.12.5",
    "@fastify/multipart": "^10.1.2",
    "zod": "^4.6.5",
    "undici": "^8.11.2",
    "resedit": "^3.1.0",
    "pe-library": "^2.0.1",
    "@playwright/test": "^1.63.0",
    "@sem/api-catalog": "workspace:*"
  }
}
