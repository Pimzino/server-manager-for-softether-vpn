# /etc/softether-manager/env — SoftEther Manager configuration
SEM_HOST=0.0.0.0
SEM_PORT=443
SEM_DATA_DIR=/var/lib/softether-manager
# 64 hex chars; generate with: openssl rand -hex 32   (keep in your secrets manager!)
# If unset, a key file is generated in SEM_DATA_DIR/master.key on first start.
#SEM_MASTER_KEY=
# TLS for the management UI (PEM). If unset, a self-signed certificate is generated.
#SEM_TLS_CERT=/etc/softether-manager/tls/fullchain.pem
#SEM_TLS_KEY=/etc/softether-manager/tls/privkey.pem
# Behind a TLS-terminating reverse proxy instead:
#SEM_HTTP=1
# Addresses/CIDRs of your reverse proxies ("1" = a proxy on this host):
#SEM_TRUST_PROXY=10.0.0.5,10.0.1.0/24
# No admin is created automatically: on first start complete setup in the web UI using the one-time
# token from the log / SEM_DATA_DIR/setup-token.txt.
SEM_SESSION_TTL_HOURS=12
SEM_SESSION_IDLE_MINUTES=60
SEM_LOGIN_RATE_LIMIT=10
SEM_POLL_INTERVAL_SEC=30
SEM_BACKUP_INTERVAL_HOURS=24
SEM_BACKUP_RETENTION=30
SEM_AUDIT_RETENTION_DAYS=365
SEM_RPC_TIMEOUT_MS=20000
# msitools (wixl/msiinfo/msibuild) for MSI builds
SEM_WIXL=wixl
SEM_LOG_LEVEL=info
